# ----------------------------------------------------------------------------
# Agent chat model (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
# Chat model name
LLM_MODEL=gpt-5.6-luna

# API key for the chat model endpoint
LLM_API_KEY=sk-...

# Base URL of an OpenAI-compatible endpoint; unset uses the OpenAI endpoint
# (e.g. https://openrouter.ai/api/v1)
# LLM_API_URL=https://api.openai.com/v1

# Agent debug output
# VERBOSE=false


# ----------------------------------------------------------------------------
# Document search embeddings (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
# Embedding model name
DOCUMENT_EMBEDDING_MODEL=text-embedding-3-small

# API key for the embedding endpoint
DOCUMENT_EMBEDDING_API_KEY=sk-...

# Base URL of an OpenAI-compatible endpoint; unset uses the OpenAI endpoint
# (e.g. https://openrouter.ai/api/v1)
# DOCUMENT_EMBEDDING_API_URL=https://api.openai.com/v1

# Retrieval parameters
# DOCUMENT_TOP_K=6
# DOCUMENT_BM25_CANDIDATES=6
# DOCUMENT_DENSE_CANDIDATES=6
# DOCUMENT_BM25_WEIGHT=0.5

# ----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ----------------------------------------------------------------------------
# DATABASE_URI is the relational connection (CRUD, tables); PGVECTOR_URI is
# the pgvector connection and defaults to DATABASE_URI, so a single-database
# setup needs one URL.
# DATABASE_URI=postgresql://postgres:postgres@db:5432/langgraph?sslmode=disable
# PGVECTOR_URI=postgresql://postgres:postgres@db:5432/langgraph?sslmode=disable

# Echo SQL statements (optional)
# DB_ECHO=false

# ----------------------------------------------------------------------------
# Sentry error monitoring, tracing and agent tracing — OPTIONAL
# ----------------------------------------------------------------------------
# The DSN from the Sentry project; leaving it unset keeps the SDK disabled.
# FastAPI and LangChain integrations turn on automatically at initialization.
# Trace sampling defaults to 1.0 outside production and 0.1 in production;
# SENTRY_TRACES_SAMPLE_RATE overrides it. SENTRY_ENVIRONMENT and SENTRY_RELEASE
# fall back to VERCEL_ENV and VERCEL_GIT_COMMIT_SHA when unset.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=<commit sha>
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ----------------------------------------------------------------------------
# Observability (Langfuse / LangSmith) — OPTIONAL
# ----------------------------------------------------------------------------
# Langfuse tracing, wired to the agent's CallbackHandler. LANGFUSE_BASE_URL is
# only needed for self-hosted instances; LANGFUSE_TRACING_ENVIRONMENT tags
# traces with the deployment environment.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production

# LangSmith API key (the langgraph-api container reads it for its license
# check).
# LANGSMITH_API_KEY=lsv2_...

# ----------------------------------------------------------------------------
# LangGraph custom auth (Amazon Cognito) — OPTIONAL
# ----------------------------------------------------------------------------
# JWT auth is active only when BOTH COGNITO_REGION and COGNITO_USER_POOL_ID
# are set; with either unset the server runs open under a single anonymous
# identity and no AWS infrastructure is needed. When active, every request
# must carry a Cognito ACCESS token as "Authorization: Bearer <jwt>": the
# signature is validated RS256 against the user pool's JWKS endpoint, and
# the issuer (https://cognito-idp.<region>.amazonaws.com/<user_pool_id>),
# expiry (30s clock-skew leeway) and token_use=access claims are checked;
# threads and runs are scoped to the caller's sub so conversations stay
# private per user.
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_ExamplePoolId
# Comma-separated allowlist of `client_id` values (registered + guest clients).
# COGNITO_APP_CLIENT_IDS=registered-app-client-id,guest-app-client-id

# ----------------------------------------------------------------------------
# Twilio WhatsApp (required for the WhatsApp integration)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
