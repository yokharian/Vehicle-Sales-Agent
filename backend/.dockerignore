# Never bake secrets or local state into images
# Docker build ignore rules for the backend/ build context
# (deploy.yml builds with context: ./backend, so this file is the one in effect)
.env
.env.*
!.env.example

# VCS and tooling state
.git
.github
.venv
.omo
.langgraph_api
.pytest_cache
.ruff_cache

# Python artifacts
__pycache__
*.pyc
*.pyo
.venv

# Docker files themselves (built from the backend context)
docker
Dockerfile
