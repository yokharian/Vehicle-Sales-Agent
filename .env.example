# ----------------------------------------------------------------------------
# Agent chat model
# ----------------------------------------------------------------------------
# Chat provider: 'openai', 'openrouter' or 'vercel'
MODEL_PROVIDER=openrouter

# Default chat model used by the agent
DEFAULT_MODEL=gpt-5.6-luna

# Agent debug output
# VERBOSE=false

# Required when MODEL_PROVIDER is 'openai'
OPENAI_API_KEY=sk-...

# Required when MODEL_PROVIDER is 'openrouter'
OPENROUTER_API_KEY=sk-or-...

# Required when MODEL_PROVIDER is 'vercel'
AI_GATEWAY_API_KEY=...


# ----------------------------------------------------------------------------
# Document search embeddings
# ----------------------------------------------------------------------------
# Embedding provider: 'openai', 'openrouter' or 'vercel'
DOCUMENT_EMBEDDING_PROVIDER=openrouter

# Embedding model
DOCUMENT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openai'
DOCUMENT_OPENAI_API_KEY=sk-...

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openrouter'
DOCUMENT_OPENROUTER_API_KEY=sk-or-...

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'vercel' (uses AI_GATEWAY_API_KEY above)

# Retrieval parameters
# DOCUMENT_TOP_K=6
# DOCUMENT_BM25_CANDIDATES=6
# DOCUMENT_DENSE_CANDIDATES=6
# DOCUMENT_BM25_WEIGHT=0.5

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Relational PostgreSQL (vehicle catalog, CRUD, tables):
# DATABASE_URI=postgresql+asyncpg://postgres:postgres@db:5432/langgraph?sslmode=disable

# Vector database (pgvector document index);
# PGVECTOR_URI=postgresql+asyncpg://postgres:postgres@db:5432/langgraph?sslmode=disable

# Echo SQL statements (optional)
# DB_ECHO=false

# ----------------------------------------------------------------------------
# LangGraph custom auth (Amazon Cognito) — OPTIONAL
# ----------------------------------------------------------------------------
# JWT auth is active only when BOTH COGNITO_REGION and COGNITO_USER_POOL_ID
# are set; with either unset the server runs open under a single anonymous
# identity and no AWS infrastructure is needed. When active, every request
# must carry a Cognito ACCESS token as "Authorization: Bearer <jwt>": the
# signature is validated RS256 against the user pool's JWKS endpoint, and
# the issuer (https://cognito-idp.<region>.amazonaws.com/<user_pool_id>),
# expiry (30s clock-skew leeway) and token_use=access claims are checked;
# threads and runs are scoped to the caller's sub so conversations stay
# private per user.
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_ExamplePoolId
# COGNITO_APP_CLIENT_ID=example-app-client-id

# ----------------------------------------------------------------------------
# Twilio WhatsApp (required for the WhatsApp integration)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
