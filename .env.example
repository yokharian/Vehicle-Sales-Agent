# ============================================================================
# Application configuration (pydantic-settings reads this file automatically)
# ============================================================================

# ----------------------------------------------------------------------------
# Agent chat model
# ----------------------------------------------------------------------------
# Chat provider: 'openai' or 'openrouter'
MODEL_PROVIDER=openrouter

# Default chat model used by the agent
DEFAULT_MODEL=gpt-5.6-luna

# Agent debug output
# VERBOSE=false

# ----------------------------------------------------------------------------
# Document search embeddings
# ----------------------------------------------------------------------------
# Embedding provider: 'openai' or 'openrouter'
DOCUMENT_EMBEDDING_PROVIDER=openrouter

# Embedding model (optional; falls back to the provider default)
DOCUMENT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Retrieval parameters
# DOCUMENT_TOP_K=6
# DOCUMENT_BM25_CANDIDATES=6
# DOCUMENT_DENSE_CANDIDATES=6
# DOCUMENT_BM25_WEIGHT=0.5

# ----------------------------------------------------------------------------
# API keys
# ----------------------------------------------------------------------------
# Required when MODEL_PROVIDER or DOCUMENT_EMBEDDING_PROVIDER is 'openai'
OPENAI_API_KEY=sk-...

# Required when a provider is 'openrouter' (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...


# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# PostgreSQL (Docker Compose 'db' service):
DATABASE_URL=postgresql://postgres:password@db:5432/commercial_agent

# Echo SQL statements (optional)
# DB_ECHO=false

# ----------------------------------------------------------------------------
# LangGraph custom auth (Supabase Auth) — OPTIONAL
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_AUDIENCE=authenticated

# ----------------------------------------------------------------------------
# Twilio WhatsApp (required for the WhatsApp integration)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
