# ----------------------------------------------------------------------------
# Agent chat model
# ----------------------------------------------------------------------------
# Chat provider: 'openai', 'openrouter' or 'vercel'
MODEL_PROVIDER=openrouter

# Default chat model used by the agent
DEFAULT_MODEL=openai/gpt-oss-20b

# Agent debug output
# VERBOSE=false

# Required when MODEL_PROVIDER is 'openai'
OPENAI_API_KEY=sk-...

# Required when MODEL_PROVIDER is 'openrouter'
OPENROUTER_API_KEY=sk-or-...

# Required when MODEL_PROVIDER is 'vercel'
AI_GATEWAY_API_KEY=...


# ----------------------------------------------------------------------------
# Document search embeddings
# ----------------------------------------------------------------------------
# Embedding provider: 'openai', 'openrouter' or 'vercel'
DOCUMENT_EMBEDDING_PROVIDER=openrouter

# Embedding model
DOCUMENT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openai'
DOCUMENT_OPENAI_API_KEY=sk-...

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openrouter'
DOCUMENT_OPENROUTER_API_KEY=sk-or-...

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'vercel' (uses AI_GATEWAY_API_KEY above)

# Retrieval parameters
# DOCUMENT_TOP_K=6
# DOCUMENT_BM25_CANDIDATES=6
# DOCUMENT_DENSE_CANDIDATES=6
# DOCUMENT_BM25_WEIGHT=0.5

# ----------------------------------------------------------------------------
# Database (Supabase Postgres)
# ----------------------------------------------------------------------------
# POSTGRES_URL_NON_POOLING is preferred: a direct session connection, so
# startup DDL (CREATE EXTENSION) and long-lived statements behave predictably.
# POSTGRES_URL and POSTGRES_PRISMA_URL point at the transaction pooler and are
# used only when the non-pooling URL is absent.
# POSTGRES_URL_NON_POOLING=postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# POSTGRES_URL=postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# POSTGRES_PRISMA_URL=postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Used to assemble a URL when none of the URLs above is set:
# POSTGRES_HOST=db.<project>.supabase.co
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=postgres

# DATABASE_URI and PGVECTOR_URI override the Supabase variables above. Leave
# them unset unless a deployment needs an explicit per-service database.
# DATABASE_URI=postgresql://postgres:postgres@db:5432/langgraph?sslmode=disable
# PGVECTOR_URI=postgresql://postgres:postgres@db:5432/langgraph?sslmode=disable

# Echo SQL statements (optional)
# DB_ECHO=false

# ----------------------------------------------------------------------------
# Supabase project credentials
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# ----------------------------------------------------------------------------
# Observability (Langfuse / LangSmith) — OPTIONAL
# ----------------------------------------------------------------------------
# Langfuse tracing, wired to the agent's CallbackHandler. LANGFUSE_BASE_URL is
# only needed for self-hosted instances; LANGFUSE_TRACING_ENVIRONMENT tags
# traces with the deployment environment.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production

# LangSmith API key (the langgraph-api container reads it for its license
# check).
# LANGSMITH_API_KEY=lsv2_...

# ----------------------------------------------------------------------------
# LangGraph custom auth (Amazon Cognito) — OPTIONAL
# ----------------------------------------------------------------------------
# JWT auth is active only when BOTH COGNITO_REGION and COGNITO_USER_POOL_ID
# are set; with either unset the server runs open under a single anonymous
# identity and no AWS infrastructure is needed. When active, every request
# must carry a Cognito ACCESS token as "Authorization: Bearer <jwt>": the
# signature is validated RS256 against the user pool's JWKS endpoint, and
# the issuer (https://cognito-idp.<region>.amazonaws.com/<user_pool_id>),
# expiry (30s clock-skew leeway) and token_use=access claims are checked;
# threads and runs are scoped to the caller's sub so conversations stay
# private per user.
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_ExamplePoolId
# Comma-separated allowlist of `client_id` values (registered + guest clients).
# COGNITO_APP_CLIENT_IDS=registered-app-client-id,guest-app-client-id

# ----------------------------------------------------------------------------
# Twilio WhatsApp (required for the WhatsApp integration)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
