# ----------------------------------------------------------------------------
# Agent chat model
# ----------------------------------------------------------------------------
# Chat provider: 'openai' or 'openrouter'
MODEL_PROVIDER=openrouter

# Default chat model used by the agent
DEFAULT_MODEL=gpt-5.6-luna

# Agent debug output
# VERBOSE=false

# Required when MODEL_PROVIDER is 'openai'
OPENAI_API_KEY=sk-...

# Required when MODEL_PROVIDER is 'openrouter'
OPENROUTER_API_KEY=sk-or-...


# ----------------------------------------------------------------------------
# Document search embeddings
# ----------------------------------------------------------------------------
# Embedding provider: 'openai' or 'openrouter'
DOCUMENT_EMBEDDING_PROVIDER=openrouter

# Embedding model
DOCUMENT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openai'
DOCUMENT_OPENAI_API_KEY=sk-...

# Required when DOCUMENT_EMBEDDING_PROVIDER is 'openrouter'
DOCUMENT_OPENROUTER_API_KEY=sk-or-...

# Retrieval parameters
# DOCUMENT_TOP_K=6
# DOCUMENT_BM25_CANDIDATES=6
# DOCUMENT_DENSE_CANDIDATES=6
# DOCUMENT_BM25_WEIGHT=0.5

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Relational PostgreSQL (vehicle catalog, CRUD, tables):
# POSTGRES_URI=postgresql+asyncpg://postgres:postgres@db:5432/langgraph?sslmode=disable

# Vector database (pgvector document index);
# PGVECTOR_URI=postgresql+asyncpg://postgres:postgres@db:5432/langgraph?sslmode=disable

# Echo SQL statements (optional)
# DB_ECHO=false

# ----------------------------------------------------------------------------
# LangGraph custom auth (Supabase Auth) — OPTIONAL
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_AUDIENCE=authenticated

# ----------------------------------------------------------------------------
# Twilio WhatsApp (required for the WhatsApp integration)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
